        "label": "Tutorial and Intel buttons (top right)",
        "default": true
      },
      {
        "prop": "touchControls",
        "control": "segmented",
        "label": "Touch buttons (auto = phones and tablets)",
        "default": "auto",
        "options": [
          "auto",
          "on",
          "off"
        ]
      }
    ]
  },
  {
    "title": "Sound",
    "controls": [
      {
        "prop": "sound",
        "control": "switch",
        "label": "Sound (starts with the first click or key)",
        "default": true
      },
      {
        "prop": "volume",
        "control": "slider",
        "label": "Volume",
        "default": 0.6,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "visibleWhen": {
          "prop": "sound",
          "equals": true
        }
      },
      {
        "prop": "radio",
        "control": "switch",
        "label": "Radio chatter during a rescue",
        "default": true,
        "visibleWhen": {
          "prop": "sound",
          "equals": true
        }
      }
    ]
  },
